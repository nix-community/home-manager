configuration {
combi-modes: [ "window","drun" ];
cycle: false;
drun {
display-name: "";
}
filebrowser {
directories-first: true;
directory: "$HOME";
sorting-method: "type";
}
font: "Droid Sans Mono 14";
kb-primary-paste: "Control+V,Shift+Insert";
kb-secondary-paste: "Control+v,Insert";
location: 7;
modes: [ "drun","emoji","foo:bar","ssh" ];
modi: [ "run","drun","window","ssh" ];
run,drun {
display-name: "open:";
}
terminal: "/some/path";
xoffset: 22;
yoffset: 3;
}
