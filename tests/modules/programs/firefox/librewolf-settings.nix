{
  configPath ? null,
  linuxOverridesDir ? ".librewolf",
}:
{
  config,
  lib,
  pkgs,
  ...
}:
let
  inherit (pkgs.stdenv.hostPlatform) isDarwin;

  firefoxMockOverlay = import ./setup-firefox-mock-overlay.nix [
    "programs"
    "librewolf"
  ];

  expectedOverrides = pkgs.writeText "expected-librewolf-overrides.cfg" ''
    // Generated by Home Manager.

    defaultPref("privacy.resistFingerprinting", false);
    defaultPref("webgl.disabled", false);

  '';

  overridesDir = if isDarwin then ".librewolf" else linuxOverridesDir;

  unexpectedOverridesDirs = lib.subtractLists [ overridesDir ] (
    lib.unique (
      [
        ".librewolf"
        ".config/librewolf/librewolf"
        "Library/Application Support/LibreWolf"
      ]
      ++ lib.optional (configPath != null) configPath
    )
  );

  nmhDir =
    if isDarwin then
      "Library/Application Support/LibreWolf/NativeMessagingHosts"
    else
      ".librewolf/native-messaging-hosts";

  nmhHost = pkgs.writeTextDir "lib/mozilla/native-messaging-hosts/com.example.nmh.json" ''
    {"name":"com.example.nmh"}
  '';
in
{
  imports = [ firefoxMockOverlay ];

  config = lib.mkIf config.test.enableBig {
    programs.librewolf = {
      enable = true;
      settings = {
        "privacy.resistFingerprinting" = false;
        "webgl.disabled" = false;
      };
      nativeMessagingHosts = [ nmhHost ];
    }
    // lib.optionalAttrs (configPath != null) { inherit configPath; };

    nmt.script = ''
      assertFileContent \
        "home-files/${overridesDir}/librewolf.overrides.cfg" \
        ${expectedOverrides}

      assertFileExists "home-files/${nmhDir}/com.example.nmh.json"
    ''
    + lib.concatMapStrings (dir: ''
      assertPathNotExists "home-files/${dir}/librewolf.overrides.cfg"
    '') unexpectedOverridesDirs
    + lib.optionalString (configPath != null) ''
      assertPathNotExists "home-files/${configPath}/native-messaging-hosts"
      assertPathNotExists "home-files/${configPath}/NativeMessagingHosts"
    '';
  };
}
