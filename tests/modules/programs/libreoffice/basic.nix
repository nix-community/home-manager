{
  programs.libreoffice = {
    enable = true;
    package = null;
    settings = {
      "/org.openoffice.Setup/Product" = {
        WhatsNew = false;
        WhatsNewDialog = false;
        ooSetupLastVersion = "25.8";
      };
      "/org.openoffice.Office.Common/Misc".FilePickerLastService = "";
      "/org.openoffice.Office.Common/Filter/Graphic/Export/PNG".Compression = 9;
    };
  };

  nmt.script = ''
    assertLinkExists "home-files/.config/libreoffice/4/user/registrymodifications.xcu"
    assertFileContent "home-files/.config/libreoffice/4/user/registrymodifications.xcu" ${builtins.toFile "expected.xcu" ''
      <?xml version="1.0" encoding="UTF-8"?>
      <!-- Generated by Home Manager. -->
      <oor:items xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <item oor:path="/org.openoffice.Office.Common/Filter/Graphic/Export/PNG"><prop oor:name="Compression" oor:op="fuse"><value>9</value></prop></item>
      <item oor:path="/org.openoffice.Office.Common/Misc"><prop oor:name="FilePickerLastService" oor:op="fuse"><value></value></prop></item>
      <item oor:path="/org.openoffice.Setup/Product"><prop oor:name="WhatsNew" oor:op="fuse"><value>false</value></prop></item>
      <item oor:path="/org.openoffice.Setup/Product"><prop oor:name="WhatsNewDialog" oor:op="fuse"><value>false</value></prop></item>
      <item oor:path="/org.openoffice.Setup/Product"><prop oor:name="ooSetupLastVersion" oor:op="fuse"><value>25.8</value></prop></item>
      </oor:items>
    ''}
  '';
}
